{
  "name": "@namiyama/crowdworks-cli",
  "version": "0.1.0",
  "description": "A local CLI and MCP server for finding CrowdWorks jobs and preparing applications.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cw": "./dist/cli.js",
    "cw-mcp": "./dist/mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup src/cli.ts src/mcp.ts --format esm --target node24 --clean",
    "dev": "tsx src/cli.ts",
    "dev:mcp": "tsx src/mcp.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "commander": "^14.0.0",
    "yaml": "^2.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/namiyama/crowdworks-cli.git"
  },
  "keywords": [
    "crowdworks",
    "cli",
    "mcp"
  ]
}
